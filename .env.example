# Site
NEXT_PUBLIC_SITE_URL=https://calculosonline.com.br

# Google Analytics 4 (nome real lido pelo código: apps/web/src/app/layout.tsx)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google AdSense — LIGA A EXIBIÇÃO de anúncios no `AdSlot`.
# Deixe VAZIA até a conta ser aprovada: o `AdSlot` cai no placeholder e
# nenhum script do adsbygoogle é carregado.
# O Publisher ID em si não mora aqui — é constante em `lib/seo.ts`
# (`siteConfig.adsensePublisherId`) e no `public/ads.txt`, porque é público
# por design e o `ads.txt` é estático. Ver F19.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=

# Microsoft Clarity (analytics)
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Vercel (preenchido automaticamente em produção)
VERCEL_URL=

# Feature flags
NEXT_PUBLIC_ENABLE_ADS=false
